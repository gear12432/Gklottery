rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && request.resource.data.email is string
        && request.resource.data.createdAt is string;
      allow update: if isOwner(userId);
    }

    // User Preferences
    match /userPreferences/{userId} {
      allow read, write: if isOwner(userId);
    }

    // User Notifications Subcollection
    match /notifications/{userId}/items/{notificationId} {
      allow read, write: if isOwner(userId);
    }

    // User CheckIns Subcollection
    match /checkIns/{userId}/history/{dateKey} {
      allow read, write: if isOwner(userId);
    }

    // User Transactions Subcollection
    match /transactions/{userId}/history/{transactionId} {
      allow read, write: if isOwner(userId);
    }

    // User Tickets Subcollection
    match /tickets/{userId}/history/{ticketId} {
      allow read, write: if isOwner(userId);
    }

    // User Support Tickets
    match /supportTickets/{userId}/history/{ticketId} {
      allow read, write: if isOwner(userId);
    }
  }
}
